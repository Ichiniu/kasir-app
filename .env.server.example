# Production/server env example for casirplus.my.id.
# Copy values into your server env, Portainer stack env, or server-side .env.

NEXT_PUBLIC_APP_NAME="Casir+"
NEXT_PUBLIC_APP_URL="https://casirplus.my.id"

NEXTAUTH_URL="https://casirplus.my.id"
NEXTAUTH_SECRET="generate-a-long-random-secret"
BETTER_AUTH_URL="https://casirplus.my.id"
BETTER_AUTH_SECRET="generate-a-long-random-secret"

POSTGRES_USER="kasir_user"
POSTGRES_PASSWORD="change-this-db-password"
POSTGRES_DB="kasir_db"

# If this stack creates its own postgres container, keep the host as postgres.
DOCKER_DATABASE_URL="postgresql://kasir_user:change-this-db-password@postgres:5432/kasir_db?schema=public"

# Optional: only expose postgres if you really need remote DB access.
# Use 5433 if another postgres already uses host port 5432.
POSTGRES_PORT="5433"

# App is exposed on host port 3003, then tunnel/NPM points to http://localhost:3003.
APP_PORT="3003"
