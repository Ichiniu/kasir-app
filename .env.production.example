# ================================================
# KASIR APP - PRODUCTION ENVIRONMENT
# Isi semua nilai ini sebelum deploy!
# ================================================

# --- DATABASE ---
POSTGRES_USER=kasir_user
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT_MIN_20_KARAKTER
POSTGRES_DB=kasir_db

# --- APP PORT (Portainer expose ke host) ---
APP_PORT=3000

# --- BETTER AUTH (WAJIB DIUBAH) ---
# Generate dengan: openssl rand -base64 32
BETTER_AUTH_SECRET=GANTI_DENGAN_SECRET_KUAT_HASIL_OPENSSL
# URL domain production Anda (tanpa trailing slash)
BETTER_AUTH_URL=https://kasir.yourdomain.com

# --- APP CONFIG ---
NEXT_PUBLIC_APP_NAME=Kasir Digital

# --- MIDTRANS ---
# Untuk production payment, ubah ke key production Midtrans
MIDTRANS_SERVER_KEY=Mid-server-XXXXXXXXXXXXXXXXX
MIDTRANS_CLIENT_KEY=Mid-client-XXXXXXXXXXXXXXXXX
MIDTRANS_IS_PRODUCTION=false
