// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Outlet Model - Untuk sistem Multi-Tenant (Multi-Outlet)
model Outlet {
  id        String   @id @default(cuid())
  nama      String
  alamat    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  categories           Category[]
  skus                 ProductSku[]
  rawMaterials         RawMaterial[]
  stocktakeFields      StocktakeField[]
  stocktakes           InventoryStocktake[]
  materialRequests     MaterialRequest[]
  products             Product[]
  transactions         Transaction[]
  transactionItems     TransactionItem[]
  inventoryAdjustments InventoryAdjustment[]
  cashRegisters        CashRegister[]
  auditLogs            AuditLog[]

  @@map("outlets")
}

// User Model - Untuk authentication dan role management
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  emailVerified Boolean?
  image         String?
  password      String?
  role          UserRole  @default(CASHIER)
  isActive      Boolean   @default(true)
  outletId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  outlet        Outlet?   @relation(fields: [outletId], references: [id])
  transactions  Transaction[]
  cashRegisters CashRegister[]
  auditLogs     AuditLog[]
  sessions      Session[]
  accounts      Account[]
  stocktakesCreated InventoryStocktake[] @relation("StocktakeCreator")
  stocktakesReviewed InventoryStocktake[] @relation("StocktakeReviewer")
  materialRequestsCreated MaterialRequest[] @relation("MaterialRequestCreator")
  materialRequestsReviewed MaterialRequest[] @relation("MaterialRequestReviewer")

  @@index([outletId])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// Audit Log - Mencatat semua aktivitas penting
model AuditLog {
  id        String   @id @default(cuid())
  outletId  String?
  userId    String
  action    String   // LOGIN, LOGOUT, CREATE_TRANSACTION, UPDATE_STOCK, etc.
  entity    String?  // TRANSACTION, PRODUCT, CASH_REGISTER, etc.
  entityId  String?
  details   String?  @db.Text
  oldValue  String?  @db.Text // Nilai lama (JSON)
  newValue  String?  @db.Text // Nilai baru (JSON)
  ipAddress String?
  createdAt DateTime @default(now())

  outlet    Outlet?  @relation(fields: [outletId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([outletId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

enum UserRole {
  SUPERADMIN
  ADMIN
  CASHIER
}

// Category Model - Kategori produk
model Category {
  id          String    @id @default(cuid())
  outletId    String
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  outlet   Outlet    @relation(fields: [outletId], references: [id])
  products Product[]

  @@index([outletId])
  @@map("categories")
}

// Product Model - Produk yang dijual
model Product {
  id          String   @id @default(cuid())
  outletId    String
  sku         String
  skuId       String?  @unique
  name        String
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  cost        Decimal  @db.Decimal(10, 2) // Harga modal
  stock       Int      @default(0)
  minStock    Int      @default(5) // Minimum stock warning
  imageUrl    String?
  isActive    Boolean  @default(true)
  unit        String   @default("Pcs")
  categoryId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  outlet               Outlet                @relation(fields: [outletId], references: [id])
  category             Category?             @relation(fields: [categoryId], references: [id])
  skuRecord            ProductSku?           @relation(fields: [skuId], references: [id])
  transactionItems     TransactionItem[]
  inventoryAdjustments InventoryAdjustment[]

  @@unique([outletId, sku])
  @@index([outletId])
  @@index([categoryId])
  @@index([sku])
  @@map("products")
}

// Master SKU - kode SKU yang tersedia untuk dipasangkan ke satu produk pada outlet.
model ProductSku {
  id        String   @id @default(cuid())
  outletId  String
  code      String
  createdAt DateTime @default(now())

  outlet  Outlet   @relation(fields: [outletId], references: [id])
  product Product?

  @@unique([outletId, code])
  @@index([outletId])
  @@map("product_skus")
}

// Bahan dapur disimpan terpisah dari produk kasir agar tidak ikut dijual di POS.
model RawMaterial {
  id           String   @id @default(cuid())
  outletId     String
  name         String
  unit         String
  currentStock Decimal  @default(0) @db.Decimal(12, 3)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  outlet Outlet @relation(fields: [outletId], references: [id])
  stocktakeLines InventoryStocktakeLine[]
  requestLines MaterialRequestLine[]

  @@unique([outletId, name])
  @@index([outletId, isActive])
  @@map("raw_materials")
}

model StocktakeField {
  id        String   @id @default(cuid())
  outletId  String
  key       String
  label     String
  type      StocktakeFieldType @default(TEXT)
  position  Int      @default(0)
  isCore    Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlet Outlet @relation(fields: [outletId], references: [id])

  @@unique([outletId, key])
  @@index([outletId, isActive, position])
  @@map("stocktake_fields")
}

model InventoryStocktake {
  id          String          @id @default(cuid())
  outletId    String
  date        DateTime        @db.Date
  shift       StocktakeShift
  status      StocktakeStatus @default(SUBMITTED)
  notes       String?         @db.Text
  reviewNotes String?         @db.Text
  createdById String
  reviewedById String?
  submittedAt DateTime        @default(now())
  reviewedAt  DateTime?
  fieldsSnapshot Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  outlet    Outlet @relation(fields: [outletId], references: [id])
  createdBy User   @relation("StocktakeCreator", fields: [createdById], references: [id])
  reviewedBy User? @relation("StocktakeReviewer", fields: [reviewedById], references: [id])
  lines     InventoryStocktakeLine[]

  @@unique([outletId, date, shift])
  @@index([outletId, status, date])
  @@map("inventory_stocktakes")
}

model InventoryStocktakeLine {
  id                 String  @id @default(cuid())
  stocktakeId        String
  rawMaterialId      String
  openingStock       Decimal @db.Decimal(12, 3)
  incoming           Decimal @default(0) @db.Decimal(12, 3)
  outgoing           Decimal @default(0) @db.Decimal(12, 3)
  endingStock        Decimal @db.Decimal(12, 3)
  physicalStock      Decimal @db.Decimal(12, 3)
  notes              String? @db.Text
  extraValues        Json?

  stocktake   InventoryStocktake @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial        @relation(fields: [rawMaterialId], references: [id])

  @@unique([stocktakeId, rawMaterialId])
  @@index([rawMaterialId])
  @@map("inventory_stocktake_lines")
}

model MaterialRequest {
  id          String                @id @default(cuid())
  outletId    String
  forDate     DateTime              @db.Date
  status      MaterialRequestStatus @default(DRAFT)
  notes       String?               @db.Text
  reviewNotes String?               @db.Text
  createdById String
  reviewedById String?
  submittedAt DateTime?
  reviewedAt  DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  outlet     Outlet @relation(fields: [outletId], references: [id])
  createdBy  User   @relation("MaterialRequestCreator", fields: [createdById], references: [id])
  reviewedBy User?  @relation("MaterialRequestReviewer", fields: [reviewedById], references: [id])
  lines      MaterialRequestLine[]

  @@unique([outletId, forDate])
  @@index([outletId, status, forDate])
  @@map("material_requests")
}

model MaterialRequestLine {
  id              String  @id @default(cuid())
  requestId       String
  rawMaterialId   String
  requestedAmount Decimal @db.Decimal(12, 3)
  notes           String? @db.Text

  request     MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial     @relation(fields: [rawMaterialId], references: [id])

  @@unique([requestId, rawMaterialId])
  @@index([rawMaterialId])
  @@map("material_request_lines")
}

// Transaction Model - Transaksi penjualan
model Transaction {
  id              String            @id @default(cuid())
  clientRequestId String?           @unique
  outletId        String
  invoiceNumber   String            @unique
  totalAmount     Decimal           @db.Decimal(10, 2)
  discountAmount  Decimal           @default(0) @db.Decimal(10, 2)
  taxAmount       Decimal           @default(0) @db.Decimal(10, 2)
  finalAmount     Decimal           @db.Decimal(10, 2)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus     @default(COMPLETED)
  cashReceived    Decimal?          @db.Decimal(10, 2) // Untuk cash payment
  changeAmount    Decimal?          @db.Decimal(10, 2) // Kembalian
  customerName    String?
  notes           String?           @db.Text
  userId          String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  outlet           Outlet             @relation(fields: [outletId], references: [id])
  user             User               @relation(fields: [userId], references: [id])
  transactionItems TransactionItem[]
  cashRegisterId   String?
  cashRegister     CashRegister?      @relation(fields: [cashRegisterId], references: [id])

  @@index([outletId])
  @@index([userId])
  @@index([invoiceNumber])
  @@index([cashRegisterId])
  @@index([createdAt])
  @@map("transactions")
}

// Cash Register - Untuk Buka/Tutup Kas
model CashRegister {
  id              String         @id @default(cuid())
  outletId        String
  userId          String
  openingBalance  Decimal        @db.Decimal(10, 2)
  closingBalance  Decimal?       @db.Decimal(10, 2)
  totalSales      Decimal        @default(0) @db.Decimal(10, 2)
  actualCash      Decimal?       @db.Decimal(10, 2) // Uang tunai fisik saat tutup
  status          RegisterStatus @default(OPEN)
  openingNotes    String?        @db.Text
  closingNotes    String?        @db.Text
  openedAt        DateTime       @default(now())
  closedAt        DateTime?

  outlet          Outlet         @relation(fields: [outletId], references: [id])
  user            User           @relation(fields: [userId], references: [id])
  transactions    Transaction[]

  @@index([outletId])
  @@index([userId])
  @@index([status])
  @@map("cash_registers")
}

enum RegisterStatus {
  OPEN
  CLOSED
}

enum PaymentMethod {
  CASH
  QRIS
  DEBIT_CARD
  CREDIT_CARD
  E_WALLET
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

// TransactionItem Model - Item dalam transaksi
model TransactionItem {
  id            String   @id @default(cuid())
  outletId      String
  transactionId String
  productId     String
  productName   String // Simpan nama produk saat transaksi untuk history
  quantity      Int
  price         Decimal  @db.Decimal(10, 2) // Harga saat transaksi
  subtotal      Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())

  outlet      Outlet      @relation(fields: [outletId], references: [id])
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])

  @@index([outletId])
  @@index([transactionId])
  @@index([productId])
  @@map("transaction_items")
}

// Stock Adjustment - Untuk stok masuk/keluar
model InventoryAdjustment {
  id        String                 @id @default(cuid())
  outletId  String
  productId String
  type      StockAdjustmentType    @default(IN)
  quantity  Int
  cost      Decimal?               @db.Decimal(10, 2) // Harga modal saat stok masuk
  price     Decimal?               @db.Decimal(10, 2) // Harga jual saat stok masuk
  notes     String?                @db.Text
  createdAt DateTime               @default(now())

  outlet    Outlet                 @relation(fields: [outletId], references: [id])
  product   Product                @relation(fields: [productId], references: [id])

  @@index([outletId])
  @@index([productId])
  @@map("inventory_adjustments")
}

enum StockAdjustmentType {
  IN
  OUT
}

enum StocktakeShift {
  MORNING
  AFTERNOON
}

enum StocktakeFieldType {
  TEXT
  NUMBER
}

enum StocktakeStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum MaterialRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

// Settings Model - Pengaturan aplikasi
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}
