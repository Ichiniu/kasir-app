# Local development env
# Copy this file to .env when developing on your laptop/PC.

# App
NEXT_PUBLIC_APP_NAME="Casir+"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-secret-change-if-needed"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="dev-secret-change-if-needed"

# Database for local npm run dev.
# Use this when the app runs on your machine and PostgreSQL runs in Docker.
DATABASE_URL="postgresql://kasir_user:kasir_password_secret@localhost:5432/kasir_db?schema=public"

# Database container credentials.
POSTGRES_USER="kasir_user"
POSTGRES_PASSWORD="kasir_password_secret"
POSTGRES_DB="kasir_db"
POSTGRES_PORT="5432"

# Database URL used only by the Next.js Docker container.
# Inside Docker Compose, the database hostname is the service name: postgres.
DOCKER_DATABASE_URL="postgresql://kasir_user:kasir_password_secret@postgres:5432/kasir_db?schema=public"

# Docker app port. Use 3003 if local port 3000 is already used.
APP_PORT="3000"

# Upload
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE=5242880
