# ====================================================================
# TEMPLATE ENVIRONMENT VARIABLE UNTUK EASYPANEL
# Salin variabel di bawah ke tab "Environment" pada Service App di Easypanel.
# ====================================================================

# 1. DATABASE
# Sesuaikan 'postgres' dengan nama service Postgres yang Anda buat di project Easypanel
# Format: postgresql://<USER>:<PASSWORD>@<SERVICE_NAME>:5432/<DATABASE_NAME>?schema=public
# Contoh jika service postgres bernama 'postgres' & user 'postgres':
DATABASE_URL="postgresql://postgres:ganti_password_db_easypanel@postgres:5432/postgres?schema=public"

# 2. DOMAIN & AUTENTIKASI
# Ganti https://kasir.domainanda.com dengan domain yang Anda daftarkan di Easypanel
BETTER_AUTH_URL="https://kasir.domainanda.com"
BETTER_AUTH_SECRET="ganti_dengan_random_string_32_karakter_misal_dari_openssl"

NEXTAUTH_URL="https://kasir.domainanda.com"
NEXTAUTH_SECRET="ganti_dengan_random_string_32_karakter_misal_dari_openssl"

# 3. APLIKASI
NEXT_PUBLIC_APP_NAME="Kasir Digital"
NEXT_PUBLIC_APP_URL="https://kasir.domainanda.com"
NODE_ENV="production"
PORT="3000"

# 4. STORAGE (Opsional)
UPLOAD_DIR="./public/uploads"
